# Copy this to .env.staging only after the separate Neon staging database and
# staging deployment exist. Never copy production values into this file.
MORROVIA_ENVIRONMENT=staging
MORROVIA_STAGING_URL=https://staging.morrovia.com
NEXT_PUBLIC_APP_URL=https://staging.morrovia.com
BETTER_AUTH_URL=https://staging.morrovia.com
BETTER_AUTH_SECRET=replace-with-a-new-staging-only-secret

# This must be a pooled URL for a separately named staging database, never
# production's URL or a generic `neondb` database.
# `options` sets the fail-closed database marker at connection startup. Neon
# does not allow this custom parameter to be persisted with ALTER DATABASE.
DATABASE_URL=postgresql://morrovia_staging_app:replace-me@your-staging-neon-host/morrovia_staging?sslmode=require&options=-c%20app.morrovia_environment%3Dstaging
MORROVIA_STAGING_DB_NAME=morrovia_staging
MORROVIA_STAGING_DB_HOST=your-staging-neon-host

# The DATABASE_URL startup option above must remain present. The preflight
# verifies it by reading current_setting('app.morrovia_environment', true).
MORROVIA_STAGING_DATABASE_ENVIRONMENT=staging

# Luna is the only live provider allowed for the staging co-pilot acceptance gate.
# OPENAI_API_KEY remains server-only; every other provider stays disabled.
MORROVIA_STAGING_PROVIDER_MODE=openai-only
NEXT_PUBLIC_ANALYTICS_ENVIRONMENT=preview
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
ADMIN_EMAILS=
GROQ_API_KEY=
OPENAI_API_KEY=replace-with-a-staging-openai-key
UNSPLASH_ACCESS_KEY=
GOOGLE_PLACES_API_KEY=
BOOKING_DEMAND_API_KEY=
BOOKING_DEMAND_AFFILIATE_ID=
EXPEDIA_RAPID_API_KEY=
SAILY_AFFILIATE_URL=
BOOKING_AFFILIATE_URL=
GROUND_TRANSPORT_AFFILIATE_URL=
NORDVPN_AFFILIATE_URL=
TRAVEL_INSURANCE_AFFILIATE_URL=
CAR_HIRE_AFFILIATE_URL=

# Store these only in the staging secret manager or this ignored local file.
# Never commit them and never reuse production credentials.
STAGING_TEST_PASSWORD_A=replace-with-a-unique-disposable-password
STAGING_TEST_PASSWORD_B=replace-with-a-unique-disposable-password
