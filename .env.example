# Optional — enables the live, server-side Journey research pass using Groq's free tier.
# Never prefix this with NEXT_PUBLIC_ and never commit your real key.
GROQ_API_KEY=
# Optional future premium provider. Not used by the current Journey prototype.
OPENAI_API_KEY=

# Required for persistent EasyT accounts and trips. Use the pooled Neon URL.
DATABASE_URL=

# Added when Neon Auth is enabled. The cookie secret can also sign EasyT
# sessions when a separate BETTER_AUTH_SECRET has not been supplied.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# EasyT application auth. Generate BETTER_AUTH_SECRET with `openssl rand -base64 32`.
NEXT_PUBLIC_APP_URL=https://app.example.invalid
BETTER_AUTH_URL=https://app.example.invalid
BETTER_AUTH_SECRET=

# Optional Google SSO. Email/password works without these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional transactional email configuration.
RESEND_API_KEY=
EMAIL_FROM=EasyT <noreply@your-verified-domain.com>
RESEND_WEBHOOK_SECRET=

# Optional production analytics. Leave blank for local and preview environments.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Comma-separated emails allowed to view the EasyT feedback dashboard.
ADMIN_EMAILS=
