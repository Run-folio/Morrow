# Optional — enables the live, server-side Journey research pass using Groq's free tier.
# Never prefix this with NEXT_PUBLIC_ and never commit your real key.
GROQ_API_KEY=
# Disabled by default. Set to shadow only in development or tests; reviews are advisory only.
MORROVIA_PLANNER_SHADOW_MODE=off
# Optional server-only OpenAI provider for semantic-intent development evaluation.
OPENAI_API_KEY=
# Disabled by default. Shadow is development-only and never changes a product trip.
MORROVIA_SEMANTIC_INTENT_MODE=active
# A one-call smoke run additionally requires this explicit value; tests/builds never set it.
MORROVIA_SEMANTIC_INTENT_SMOKE=off

# Optional live destination photography for generated Journey plans. Use the
# Unsplash Access Key only; keep it server-side and never commit the real value.
UNSPLASH_ACCESS_KEY=

# Optional live operational-status filtering for nearby stays. Without this,
# Morrovia uses mapped properties and labels them "Check availability".
GOOGLE_PLACES_API_KEY=

# A live inventory partner (Booking.com Demand or Expedia Rapid) is required
# before Morrovia can claim a room is available for specific dates. Keep these
# server-only; the adapter is intentionally not enabled without a contract.
BOOKING_DEMAND_API_KEY=
# Booking.com Demand API also requires a Managed Affiliate ID. Both variables
# remain server-only; without both, Morrovia keeps stays as map suggestions.
BOOKING_DEMAND_AFFILIATE_ID=
# Optional two-letter residence country used to price and tax the search.
BOOKING_DEMAND_BOOKER_COUNTRY=gb
# Optional sandbox or proxy override; production defaults to the v3.2 URL.
BOOKING_DEMAND_API_BASE_URL=
EXPEDIA_RAPID_API_KEY=

# Optional affiliate links for the trip "Before you go" layer. These are
# regular tracked destination URLs (not API keys) and remain server-only until
# returned for a relevant contextual card. Saily is the first live partner.
# A URL itself enables its optional partner. Set the matching *_ENABLED=true
# only when intentionally enabling a partner before its URL is available; this
# produces a concise server startup warning and retains the normal fallback.
SAILY_AFFILIATE_URL=
SAILY_AFFILIATE_ENABLED=false
GROUND_TRANSPORT_AFFILIATE_URL=
GROUND_TRANSPORT_AFFILIATE_ENABLED=false
# Reserved for a future, carefully scoped internet-access guide. Do not enable
# this for a destination until the copy and current local guidance are reviewed.
NORDVPN_AFFILIATE_URL=
TRAVEL_INSURANCE_AFFILIATE_URL=
CAR_HIRE_AFFILIATE_URL=
CAR_HIRE_AFFILIATE_ENABLED=false

# Required for persistent Morrovia accounts and trips. Use the pooled Neon URL.
DATABASE_URL=

# Added when Neon Auth is enabled. The cookie secret can also sign Morrovia
# sessions when a separate BETTER_AUTH_SECRET has not been supplied.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Morrovia application auth. Generate BETTER_AUTH_SECRET with
# `openssl rand -base64 32`. Set both URLs to the exact origin for the running
# environment: http://localhost:3000, https://staging.morrovia.com, or
# https://morrovia.com (no path).
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Optional Google sign-in. Both are server configuration; never use a
# NEXT_PUBLIC_ prefix. Email/password remains available without them.
# Google Cloud authorised redirect URIs:
# http://localhost:3000/api/auth/callback/google
# https://staging.morrovia.com/api/auth/callback/google
# https://morrovia.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional transactional email configuration.
RESEND_API_KEY=
EMAIL_FROM=Morrovia <noreply@your-verified-domain.com>
RESEND_WEBHOOK_SECRET=

# Optional deliberate forwarded-booking import. Keep disabled until a Resend
# receiving subdomain, MX records, and the separately signed inbound webhook
# are configured. Do not use the root mail domain if it already has MX records.
BOOKING_IMPORT_ENABLED=false
BOOKING_IMPORT_RECEIVING_DOMAIN=
RESEND_INBOUND_WEBHOOK_SECRET=

# Optional production-only GA4 analytics. Clarity remains disabled in code until
# its deployed replay and masking configuration is verified.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Optional public Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=
# Optional PostHog product analytics. The project token is public by design;
# never place a PostHog personal API key here. Both values are required.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional explicit traffic label: production, preview, or development.
NEXT_PUBLIC_ANALYTICS_ENVIRONMENT=

# Comma-separated emails allowed to view the Morrovia feedback dashboard.
ADMIN_EMAILS=

# Optional server-only Viator Affiliate API inventory. Never use NEXT_PUBLIC_
# for either key. Sandbox is the safe default until production is approved.
VIATOR_API_KEY_SANDBOX=
VIATOR_API_KEY_PRODUCTION=
VIATOR_API_ENV=sandbox

# Optional server-only road routing. OpenRouteService directions are used only
# as a conservative fallback for otherwise unresolved same-country land legs.
# Never expose this key through a NEXT_PUBLIC_ variable.
OPENROUTESERVICE_API_KEY=
